APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Bases sources (optionnel) : PostgreSQL en test, Oracle en production.
# Une variable absente reprend la valeur de SOURCE_DB_* (connexion commune « source »).
# Pour séparer les bases, renseigner DGI_SOURCE_CONNECTION_<GROUPE>=source_<groupe>
# et les paramètres SOURCE_<GROUPE>_DB_* correspondants :
#   Groupes : DECLARATIONS, ASSUJETTISSEMENTS, CONTRIBUABLES, CENTRES, AGENTS,
#             RECOUPEMENT, DAU (ces deux derniers : tables de config/risque.php)
#   SOURCE_<GROUPE>_DB_SCHEMA = propriétaire Oracle des tables, si ce n'est pas
#             l'utilisateur de la connexion (tables dans un autre schéma).
#
# Exemple Oracle (une base par groupe) :
#   SOURCE_DB_DRIVER=oracle
#   SOURCE_DB_HOST=10.0.0.10
#   SOURCE_DB_PORT=1521
#   SOURCE_DB_SERVICE_NAME=ORCLPDB1
#   SOURCE_DB_DATABASE=ORCLPDB1
#   SOURCE_DB_USERNAME=DGI_APP
#   SOURCE_DB_PASSWORD=...
#   SOURCE_DB_CHARSET=AL32UTF8
#   SOURCE_DB_TNS=              # descripteur TNS complet ou alias de wallet (prioritaire)
#
#   DGI_SOURCE_CONNECTION=source
#   DGI_SOURCE_CONNECTION_DECLARATIONS=source_declarations
#   DGI_SOURCE_CONNECTION_CONTRIBUABLES=source_contribuables
#   SOURCE_DECLARATIONS_DB_HOST=10.0.0.11
#   SOURCE_DECLARATIONS_DB_SERVICE_NAME=DECLPDB1
#   SOURCE_DECLARATIONS_DB_DATABASE=DECLPDB1
#   SOURCE_DECLARATIONS_DB_USERNAME=DGI_DECL
#   SOURCE_DECLARATIONS_DB_PASSWORD=...
#   SOURCE_CONTRIBUABLES_DB_HOST=10.0.0.12
#   SOURCE_CONTRIBUABLES_DB_SERVICE_NAME=CONTRIBPDB1
#   SOURCE_CONTRIBUABLES_DB_USERNAME=DGI_CONTRIB
#   SOURCE_CONTRIBUABLES_DB_PASSWORD=...
#
# Prérequis Oracle : extension PHP oci8 (composer exige ext-oci8 via yajra/laravel-oci8)
# et le client Oracle Instant Client. Puis : php artisan config:clear
# Installation pas à pas (client + serveur XE local) :
#   docs/installation-oracle-oci8-windows.md et docs/serveur-oracle-local-windows.md

# Aucune migration ne crée de table "sessions" (authentification par jetons Sanctum) :
# "database" ferait échouer toute route utilisant la session. Garder "file".
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
