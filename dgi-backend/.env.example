# Copier en .env sur le serveur, puis remplacer toutes les valeurs CHANGE_ME.
APP_NAME="DGI - Systeme d'analyse"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dgi.example.mg
FRONTEND_URL=https://dgi.example.mg
CORS_ALLOWED_ORIGINS=https://dgi.example.mg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base applicative : PostgreSQL. Garder DB_CONNECTION=pgsql.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dgi_app
DB_USERNAME=dgi_app
DB_PASSWORD=CHANGE_ME

# Base source : Oracle 21c, en lecture seule pour l'application.
# Remplacer l'hôte et le port par ceux accessibles depuis le serveur web.
# Le port Oracle est souvent 1521 ; l'installation actuelle peut utiliser 1522.
SOURCE_DB_DRIVER=oracle
SOURCE_DB_HOST=ORACLE_HOST_OR_IP
SOURCE_DB_PORT=1522
SOURCE_DB_SERVICE_NAME=XEPDB1
SOURCE_DB_DATABASE=XE
SOURCE_DB_USERNAME=DGI_RO
SOURCE_DB_PASSWORD=CHANGE_ME
SOURCE_DB_SCHEMA=EKAJY
SOURCE_DB_CHARSET=AL32UTF8
DGI_SOURCE_CONNECTION=source

# Noms des tables Oracle utilisés actuellement par le projet.
DGI_SOURCE_COL_CHIFFRE_AFFAIRES=chiffre_affaires
DGI_SOURCE_TABLE_IR=declaration_ir
DGI_SOURCE_TABLE_TVA=declaration_tva
DGI_SOURCE_TABLE_ASSUJETTISSEMENT=assujettissement
DGI_SOURCE_TABLE_CONTRIBUABLES=info_contribuable
DGI_SOURCE_TABLE_CENTRES=centre_gestionnaire
DGI_SOURCE_TABLE_RECOUPEMENT=a_tab_recoupement
DGI_SOURCE_TABLE_DAU=a_tab_dau

# Pour des bases Oracle distinctes, définir DGI_SOURCE_CONNECTION_<GROUPE>
# avec une connexion configurée par groupe. Préfixes pris en charge :
# DECLARATIONS, ASSUJETTISSEMENTS, CONTRIBUABLES, CENTRES, AGENTS,
# RECOUPEMENT et DAU. Voir config/database.php et config/dgi.php.

# Authentification par jetons Sanctum : ne pas utiliser "database" ici,
# car le projet ne possède pas de table de sessions.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=127.0.0.1,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Envoi des codes de vérification par SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.mg
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@example.mg
MAIL_FROM_NAME="${APP_NAME}"

# Facultatif : laisser vide si aucun service AWS n'est utilisé.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
